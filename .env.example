# Copy to .env (or export) — every value is optional in development.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
# SQLite database file (":memory:" for an ephemeral database)
DATABASE_PATH=./var/rcp.sqlite
# REQUIRED in production: at least 32 random characters (e.g. `openssl rand -hex 32`)
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# scrypt cost parameter N (power of two)
SCRYPT_COST=16384
# Comma-separated list of browser origins allowed for CORS and WebSocket upgrades
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BODY_LIMIT_BYTES=1048576
# Set to true when serving over HTTPS to send Strict-Transport-Security
HSTS=false
# Honour X-Forwarded-For (only behind a trusted reverse proxy)
TRUST_PROXY=false
# If set, /metrics requires "Authorization: Bearer <token>" (min 16 chars)
METRICS_TOKEN=
# Directory with the built web client; defaults to apps/web/dist when it exists
STATIC_DIR=
SNAPSHOT_EVERY_OPS=200
LOG_LEVEL=info
# Optional JSON config file layered below environment variables (see examples/config.example.json)
CONFIG_FILE=
